# Copy this file to .vlog_vla.env and fill in machine-specific paths.

# Optional runtime switches
WANDB_MODE=disabled
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}

# Shared roots
PROJECT_ROOT=/home/nlk/project/vlog_vla
PLAYGROUND_ROOT=${PROJECT_ROOT}/playground
PRETRAINED_ROOT=${PLAYGROUND_ROOT}/Pretrained_models
DATASETS_ROOT=${PLAYGROUND_ROOT}/Datasets
CODE_ROOT=${PLAYGROUND_ROOT}/Code
CHECKPOINT_ROOT=${PLAYGROUND_ROOT}/Checkpoints

# Qwen and StarVLA checkpoints live under playground/Pretrained_models/.
BASE_VLM=${PRETRAINED_ROOT}/Qwen3-VL-4B-Instruct

# Released benchmark checkpoints.
LIBERO_CKPT_DIR=${PRETRAINED_ROOT}/StarVLA_Qwen3_VL_OFT_LIBERO_4in1
LIBERO_CKPT=${LIBERO_CKPT_DIR}/checkpoints/steps_50000_pytorch_model.pt
ROBOTWIN_CKPT_DIR=${PRETRAINED_ROOT}/Qwen3-VL-OFT-RoboTwin2-All
ROBOTWIN_CKPT=${ROBOTWIN_CKPT_DIR}/checkpoints/steps_140000_pytorch_model.pt
ROBOCASA_OFT_CKPT_DIR=${PRETRAINED_ROOT}/Qwen3-VL-OFT-Robocasa
ROBOCASA_OFT_CKPT=${ROBOCASA_OFT_CKPT_DIR}/checkpoints/steps_90000_pytorch_model.pt
ROBOCASA_GR00T_CKPT_DIR=${PRETRAINED_ROOT}/Qwen3-VL-GR00T-Robocasa-gr1
ROBOCASA_GR00T_CKPT=${ROBOCASA_GR00T_CKPT_DIR}/checkpoints/steps_90000_pytorch_model.pt

# Dataset roots used by the merged StarVLA examples.
LIBERO_DATA_ROOT=${DATASETS_ROOT}/LEROBOT_LIBERO_DATA
ROBOTWIN_DATA_ROOT=${DATASETS_ROOT}/RoboTwin
ROBOCASA365_DATA_ROOT=${DATASETS_ROOT}/robocasa365
ROBOCASA_TABLETOP_DATA_ROOT=${DATASETS_ROOT}/nvidia/PhysicalAI-Robotics-GR00T-X-Embodiment-Sim

# External simulator checkouts.
LIBERO_HOME=${CODE_ROOT}/LIBERO
ROBOTWIN_PATH=${CODE_ROOT}/RoboTwin
ROBOCASA365_PATH=${CODE_ROOT}/robocasa365
ROBOSUITE_PATH=${CODE_ROOT}/robosuite
ROBOCASA_TABLETOP_PATH=${CODE_ROOT}/robocasa-gr1-tabletop-tasks

# VLOG training defaults
WANDB_ENTITY=your_wandb_entity
BASE_CKPT=${LIBERO_CKPT}
DATA_ROOT=${LIBERO_DATA_ROOT}
RUN_ROOT_DIR=results/Checkpoints
RUN_ID=VLOG_VLA_QwenOFT_LIBERO_REAL
TRAIN_STAGE=stage1_preserve
MAX_TRAIN_STEPS=1000
SAVE_INTERVAL=1000
EVAL_INTERVAL=1000
PER_DEVICE_BATCH_SIZE=1
NUM_PROCESSES=1
DATA_MIX=libero_all
VIDEO_BACKEND=decord

# Optional evaluation defaults
HOST=127.0.0.1
PORT=5694
TASK_SUITE_NAME=libero_spatial
NUM_TRIALS_PER_TASK=2
UNNORM_KEY=franka
OUTPUT_DIR=outputs/vlog_stage7_real_starvla/official_eval_smoke
